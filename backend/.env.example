# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# MongoDB Atlas URI (get from cloud.mongodb.com -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart_inventory?retryWrites=true&w=majority&appName=Cluster0

# OR Local MongoDB
# MONGODB_URI=mongodb://localhost:27017

# Database name
MONGODB_DB_NAME=smart_inventory

# JWT Secret Key (change this to a random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_me

# YOLOv8 model weights path (leave blank to use default yolov8n.pt)
# MODEL_WEIGHTS_PATH=backend/weights/best.pt
